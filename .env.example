# Bu dosyayı ".env" adıyla kopyalayıp kendi Supabase bilgilerinizi yazın.
# Supabase → Project Settings → API (ya da "Connect" düğmesi)
EXPO_PUBLIC_SUPABASE_URL=https://PROJE-KODUNUZ.supabase.co
# "anon public" (eyJ... ile başlar) ya da "publishable" (sb_publishable_... ile başlar) anahtar
EXPO_PUBLIC_SUPABASE_ANON_KEY=buraya-anahtar
